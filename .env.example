# 上海科技大学 OA 账号（服务端读取）
# 复制本文件为 .env 后填写
MYUSERNAME=your_username_here
PASSWORD=your_password_here

# 可选：服务端口 / 采集并发数（默认 8787 / 6）
GYMBOOK_PORT=8787
CONCURRENCY=6

# 刷新频率：三种方式任选其一（优先级 CRON_EXPR > REFRESH_INTERVAL > cron.txt）
# REFRESH_INTERVAL=10m
# CRON_EXPR=*/10 * * * *
# CRON_DISABLED=1

# 预约（半自动）表单里的「现场责任人 / 联系电话」，可留空，前端填
BOOK_OWNER=
BOOK_PHONE=
